#!/usr/bin/env bash
#
# Three things must be true before anything reaches a phone:
#
#   1. The test suite passes.
#   2. Every vibe still meets the contrast contract.
#   3. A change to a precached file moved BUILD in sw.js.
#
# The third is the one unique to this project. Otherworld Bookshelf is an
# installed PWA: the service worker serves the app shell cache-first, and the
# ONLY thing that invalidates that cache is the BUILD counter feeding the CACHE
# name. Ship a changed file without moving BUILD and every phone that already
# has the app keeps running the old code — silently, with nothing on screen to
# say so. APP_VERSION is not that safety net; it is a human-facing stamp.
#
# The first two live here because there is no CI and no build step. A guard that
# has to be remembered is a guard that eventually isn't, and both of these have
# already caught real problems: the suite found a wrong contract on its first
# run, and this hook itself blocked a push whose eleven changed modules would
# have been served stale.
#
# Bypass with: git push --no-verify
#
set -uo pipefail

fail() { echo "" >&2; echo "$@" >&2; echo "" >&2; }

cd "$(git rev-parse --show-toplevel)" || exit 1

# Everything below runs against the WORKING TREE, which for an ordinary push is
# what is being pushed. Checking out the pushed revision to a temp worktree
# would be more precise and much slower; the BUILD check further down does read
# the actual revisions, because that one compares against the remote.
#
# node is required. Skipping silently when it is absent would quietly disarm
# both guards on exactly the machine least likely to notice.
if ! command -v node >/dev/null 2>&1; then
  fail "pre-push: node isn't on PATH, so the tests and the contrast audit can't run.

Install node, or push with --no-verify if you know what you're doing."
  exit 1
fi

# </dev/null on every command below: git feeds the ref list to this hook on
# stdin, and a child process that reads it would eat the loop's input.
if ! node tests/run.mjs </dev/null; then
  fail "pre-push: tests failed. Fix them, or push with --no-verify."
  exit 1
fi

if ! node styles/vibes/audit.mjs </dev/null >/dev/null 2>&1; then
  node styles/vibes/audit.mjs </dev/null >&2 || true
  fail "pre-push: a vibe fails the contrast contract or is missing a token.

Every vibe must define the full set in styles/tokens.css and meet WCAG AA.
Run: node styles/vibes/audit.mjs

To push anyway: git push --no-verify"
  exit 1
fi

# Read the precache list out of a given revision's sw.js, as repo-relative
# paths. Entries look like "  './js/main.js',"; './' itself becomes empty and
# is dropped.
assets_at() {
  git show "$1:sw.js" 2>/dev/null \
    | sed -n '/^const ASSETS/,/^\];/p' \
    | grep -oE "'\./[^']*'" \
    | tr -d "'" \
    | sed 's|^\./||' \
    | grep -v '^$'
}

build_at() {
  git show "$1:sw.js" 2>/dev/null \
    | sed -n 's/^const BUILD *= *\([0-9][0-9]*\).*/\1/p' \
    | head -1
}

status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  # Branch deletion — nothing to check.
  [[ "$local_sha" =~ ^0+$ ]] && continue

  if [[ "$remote_sha" =~ ^0+$ ]]; then
    # New branch on the remote: compare against wherever it diverged from main.
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null) || base=""
  else
    base="$remote_sha"
  fi

  # No usable base (first push of a fresh repo) — nothing to compare, allow it.
  [[ -z "$base" ]] && continue

  changed=$(git diff --name-only "$base" "$local_sha" -- 2>/dev/null)
  [[ -z "$changed" ]] && continue

  assets=$(assets_at "$local_sha")
  if [[ -z "$assets" ]]; then
    fail "pre-push: could not parse the ASSETS list in sw.js. Fix the hook in
  .githooks/pre-push, or push with --no-verify if this is intentional."
    exit 1
  fi

  # Every precached path must actually exist in the revision being pushed.
  #
  # install() calls cache.addAll(ASSETS), which is all-or-nothing: one 404 and
  # the whole install rejects, the new worker never activates, and every
  # installed phone keeps serving the OLD app — the same silent-stale failure
  # the BUILD check below exists to prevent, reached by renaming or deleting a
  # file and leaving its entry behind. './' is the app root and has no blob.
  missing=""
  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    if ! git cat-file -e "$local_sha:$f" 2>/dev/null; then
      missing+="  $f"$'\n'
    fi
  done <<<"$assets"

  if [[ -n "$missing" ]]; then
    fail "pre-push: sw.js precaches files that don't exist on ${local_ref#refs/heads/}:

$missing
cache.addAll() is all-or-nothing — one missing file and the service worker
install fails, so installed phones keep serving the old app with nothing on
screen to say so. Remove these entries from ASSETS in sw.js (or restore the
files), then push again.

To push anyway: git push --no-verify"
    status=1
    continue
  fi

  # Which of the changed files are actually precached?
  hits=""
  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    if grep -Fxq -- "$f" <<<"$assets"; then
      hits+="  $f"$'\n'
    fi
  done <<<"$changed"

  [[ -z "$hits" ]] && continue

  old_build=$(build_at "$base")
  new_build=$(build_at "$local_sha")

  if [[ -z "$new_build" ]]; then
    fail "pre-push: no 'const BUILD = <number>' found in sw.js on ${local_ref#refs/heads/}."
    status=1
    continue
  fi

  # sw.js absent or differently shaped at the base — can't compare, allow.
  [[ -z "$old_build" ]] && continue

  if (( new_build <= old_build )); then
    fail "pre-push: BUILD in sw.js is still $new_build, but these precached files changed:

$hits
Installed phones would keep serving the cached copies of those files
indefinitely. Raise BUILD to $((old_build + 1)) in sw.js, amend or add a
commit, and push again.

  (APP_VERSION is a separate number and should NOT be bumped here — it
   tracks plan phases, not deploys.)

To push anyway: git push --no-verify"
    status=1
  fi
done

exit $status
